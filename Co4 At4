mysql> CREATE PROCEDURE run_full_benchmark(IN target_rows INT)
    -> BEGIN
    ->     -- Reset tables for clean test run
    ->     TRUNCATE TABLE txn_heap;
    ->     TRUNCATE TABLE txn_hash;
    ->     TRUNCATE TABLE txn_btree;
    ->
    ->     -- 1. Populate Clustered B+ Tree with exact 200-byte records
    ->     INSERT INTO txn_btree (
    ->         TxnID, AccountNo, TxnTime, Type, Amount, Branch, Channel, Narration, Balance, OtherData
    ->     )
    ->     WITH RECURSIVE seq AS (
    ->         SELECT 1 AS n
    ->         UNION ALL
    ->         SELECT n + 1 FROM seq WHERE n < target_rows
    ->     )
    ->     SELECT
    ->         n AS TxnID,
    ->         CONCAT('ACC', LPAD(MOD(n, 100000), 9, '0')) AS AccountNo,
    ->         1730000000 + n AS TxnTime,
    ->         IF(MOD(n, 2) = 0, 'C', 'D') AS Type,
    ->         ROUND(100 + (MOD(n * 37, 50000) / 100), 2) AS Amount,
    ->         CONCAT('BRANCH_', LPAD(MOD(n, 500), 4, '0')) AS Branch,
    ->         ELT(MOD(n, 4) + 1, 'UPI', 'NEFT', 'IMPS', 'ATM') AS Channel,
    ->         RPAD(CONCAT('TXN_REF_', n), 80, ' ') AS Narration,
    ->         ROUND(50000 + (MOD(n * 19, 100000) / 10), 2) AS Balance,
    ->         RPAD('META_DATA_PADDING', 45, 'X') AS OtherData
    ->     FROM seq;
    ->
    ->     -- 2. Replicate identical dataset into Heap and Hash tables
    ->     INSERT INTO txn_heap SELECT * FROM txn_btree;
    ->     INSERT INTO txn_hash SELECT * FROM txn_btree;
    ->
    ->     -- 3. Update table statistics
    ->     ANALYZE TABLE txn_heap, txn_hash, txn_btree;
    ->
    ->     -- 4. Log space & block metrics into experiment_results
    ->     INSERT INTO experiment_results (
    ->         DatasetSize, StrategyName, StorageEngine, RecordCount,
    ->         DataSize_MB, IndexSize_MB, TotalSize_MB,
    ->         Est_4KB_Data_Blocks, Est_4KB_Index_Blocks
    ->     )
    ->     SELECT
    ->         target_rows,
    ->         TABLE_NAME,
    ->         ENGINE,
    ->         TABLE_ROWS,
    ->         ROUND(DATA_LENGTH / (1024 * 1024), 2),
    ->         ROUND(INDEX_LENGTH / (1024 * 1024), 2),
    ->         ROUND((DATA_LENGTH + INDEX_LENGTH) / (1024 * 1024), 2),
    ->         CEIL(DATA_LENGTH / 4096),
    ->         CEIL(INDEX_LENGTH / 4096)
    ->     FROM information_schema.TABLES
    ->     WHERE TABLE_SCHEMA = 'bank_txn_db'
    ->       AND TABLE_NAME IN ('txn_heap', 'txn_hash', 'txn_btree');
    -> END //
